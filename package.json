{
  "name": "incident-management",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --open launchpage.html#Shell-home --livereload false",
    "watch-incidents": "cds watch --open ns.incidents/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "custom",
        "impl": "./srv/auth/custom-auth.js",
        "users": {
          "alice": {
            "password": "alice",
            "roles": ["support"]
          },
          "bob": {
            "password": "bob",
            "roles": ["support"]
          }
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/incidents"
  ]
}
